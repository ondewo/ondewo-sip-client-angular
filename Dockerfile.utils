# Release utilities: npm publish and the GitHub release run in here, so the release host needs no node,
# npm or gh. Credentials reach a container only through `docker run -e NAME` at the step that uses them;
# nothing in this file carries one.

# Pinned by version AND digest (the same value as NODE_IMAGE in the Makefile).
ARG NODE_IMAGE=node:24.14.0-bookworm@sha256:5a593d74b632d1c6f816457477b6819760e13624455d587eef0fa418c8d0777b

# ---- tools: node, npm, make and gh. Needs no build output, so release_preflight can build it
# before anything is generated, committed or pushed.
FROM ${NODE_IMAGE} AS tools

ARG GH_VERSION=2.100.0
ARG GH_SHA256=e4d4bb4498e8d007abe545b6568926793ace1b6447da598294a610018cb164be

ENV LANG=C.UTF-8

RUN curl -fsSL -o /tmp/gh.tar.gz "https://github.com/cli/cli/releases/download/v${GH_VERSION}/gh_${GH_VERSION}_linux_amd64.tar.gz" \
  && echo "${GH_SHA256}  /tmp/gh.tar.gz" | sha256sum -c - \
  && tar -xzf /tmp/gh.tar.gz -C /tmp \
  && install -m 0755 "/tmp/gh_${GH_VERSION}_linux_amd64/bin/gh" /usr/local/bin/gh \
  && rm -rf /tmp/gh.tar.gz "/tmp/gh_${GH_VERSION}_linux_amd64" \
  && gh --version

WORKDIR /home/ondewo/

# ---- release: the tools plus what the publish and the GitHub release read.
FROM tools AS release

COPY Makefile LICENSE README.md RELEASE.md ./

COPY npm npm
